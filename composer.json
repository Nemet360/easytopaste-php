{
  "name": "nemet360/easytopaste",
  "description": "Share a password or API key from PHP as a one-time, client-encrypted link. The key never reaches the service.",
  "type": "library",
  "keywords": ["secrets", "one-time", "encryption", "password", "sharing", "zero-knowledge"],
  "homepage": "https://easytopaste.com/?utm_source=packagist&utm_medium=php&utm_campaign=launch-2026-11",
  "license": "MIT",
  "support": {
    "email": "support@easytopaste.com",
    "source": "https://github.com/Nemet360/easytopaste-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-openssl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": { "EasyToPaste\\": "src/" }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": { "sort-packages": true }
}
